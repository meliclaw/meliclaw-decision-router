# Local/dev image for Meliclaw Decision Router — CPU only, arm64-first.
#
# Builder stages are unchanged from tools/docker/Dockerfile.extproc (known-good
# golang/python-slim toolchains); only the final runtime stage moves to
# ubuntu:26.04, per this environment's base-image choice. The canonical
# tools/docker/Dockerfile.extproc (cpu/rocm/cuda matrix, used by CI) is not
# modified by this file.
#
#   docker build -f deploy/compose/Dockerfile.local -t meliclaw-decision-router:local .
ARG IMAGE_REGISTRY=docker.io/
ARG PYTHON_IMAGE=library/python:3.12-slim-bookworm
ARG RUNTIME_IMAGE=library/ubuntu:26.04

FROM --platform=$BUILDPLATFORM ${IMAGE_REGISTRY}library/golang:1.25-bookworm AS router-build
ARG TARGETARCH
RUN if [ "$TARGETARCH" = arm64 ] && [ "$(dpkg --print-architecture)" != arm64 ]; then \
      apt-get update && \
      apt-get install -y --no-install-recommends gcc-aarch64-linux-gnu libc6-dev-arm64-cross && \
      rm -rf /var/lib/apt/lists/*; \
    fi
WORKDIR /src/semantic-router
ENV GOPROXY="https://proxy.golang.org|direct"
COPY src/semantic-router/go.mod src/semantic-router/go.sum ./
RUN go mod download
COPY src/semantic-router/ ./
RUN if [ "$TARGETARCH" = arm64 ] && [ "$(dpkg --print-architecture)" != arm64 ]; then \
      export CC=aarch64-linux-gnu-gcc; \
    fi && \
    CGO_ENABLED=1 GOOS=linux GOARCH="$TARGETARCH" \
      go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/router ./cmd

FROM --platform=$BUILDPLATFORM ${IMAGE_REGISTRY}${PYTHON_IMAGE} AS image-routing-assets
WORKDIR /source
COPY tools/calibration/image-routing/prepare_assets.py tools/calibration/image-routing/prepare_assets.py
COPY config/assets/image-routing/manifest.json config/assets/image-routing/manifest.json
COPY website/static/img/ website/static/img/
COPY dashboard/frontend/public/ dashboard/frontend/public/
RUN python tools/calibration/image-routing/prepare_assets.py --repository-root /source --output /out

# Runtime: ubuntu:26.04, CPU-only PyTorch, no ROCm/CUDA (local dev only).
FROM ${IMAGE_REGISTRY}${RUNTIME_IMAGE} AS runtime
ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv curl ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
ARG TORCH_CPU=torch==2.10.0
RUN pip install --index-url https://download.pytorch.org/whl/cpu "$TORCH_CPU" && \
    python3 -c "import torch"

ARG MODEL_RUNTIME_EXTRAS=multimodal
RUN --mount=type=bind,source=src/model-runtime/pyproject.toml,target=/tmp/pyproject.toml \
    --mount=type=bind,source=src/model-runtime/requirements-lock.txt,target=/tmp/requirements-lock.txt \
    python3 - $MODEL_RUNTIME_EXTRAS >/tmp/runtime-requirements.txt <<'EOF' && \
    pip install -c /tmp/requirements-lock.txt -r /tmp/runtime-requirements.txt && \
    rm /tmp/runtime-requirements.txt
import sys, tomllib
project = tomllib.load(open("/tmp/pyproject.toml", "rb"))["project"]
extras = project.get("optional-dependencies", {})
print("\n".join(project["dependencies"] + [dep for name in sys.argv[1:] for dep in extras[name]]))
EOF
RUN --mount=type=bind,source=src/model-runtime,target=/tmp/model-runtime,rw \
    pip install --no-deps /tmp/model-runtime

FROM runtime AS meliclaw-decision-router-local
WORKDIR /app
RUN mkdir -p /app/config /app/models && \
    useradd --uid 65532 --no-create-home --shell /usr/sbin/nologin meliclaw-decision-router
ENV USER=meliclaw-decision-router
ENV VLLM_SRUN_CACHE_DIR=/app/models/model-runtime \
    TRITON_CACHE_DIR=/app/models/triton
COPY --link --from=image-routing-assets /out/ /app/share/image-routing/
COPY config/knowledge_bases/ /app/config/knowledge_bases/
COPY config/config.yaml /app/config/config.yaml
COPY src/vllm-sr/cli/ /app/cli/
COPY src/semantic-router/pkg/configschema/router-config-v0.3.schema.json /app/cli/config_schema/router-config-v0.3.schema.json
COPY config/recipes/built-in/ /app/cli/model_assets/
COPY config/fragments/algorithm/selection/latency-aware.yaml /app/cli/proposal_assets/fragments/algorithm/selection/latency-aware.yaml
COPY --chmod=0755 src/vllm-sr/start-router.sh /app/start-router.sh
COPY --link --from=router-build /out/router /usr/local/bin/router
EXPOSE 50051 8080 9190
VOLUME ["/app/models"]
ENTRYPOINT ["/app/start-router.sh"]
